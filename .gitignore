build/
**/__pycache__/
**/tensorboard/
**/*.bin
# results/ holds generated analysis artifacts. The interactive HTML figures are
# versioned (they are a deliverable); bulk run outputs are not.
results/*
!results/html/
!results/experiments/
.ipynb_checkpoints/
.pytest_cache/
outputs
*.log
**/*.mp4
**/*.pkf

# Raw simulation output under dataset/ is not versioned, but the released
# artifacts are: the format README, the 10k benchmark CSV and the four paper
# scenes. Anything else dropped into dataset/ stays ignored by default.
/dataset/*
!/dataset/README.md
!/dataset/bubble_gym/
!/dataset/bubble_theater/
!/dataset/fruit_splash/
!/dataset/single_rising_bubble/
!/dataset/exhalation/

# The 400x400 thumbnail masters (868 MB) are the paper-resolution renders; only
# the 100x100 copies ship. Regenerate the masters with
#   python python/visualization/render_dataset_thumbnails.py --out-size 0
# The exception is the eight callout bubbles Fig. 4 draws, renormalised to a
# common fill: without them plot_dataset_distribution.py falls back to the
# 100x100 library and cannot reproduce the published figure.
/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/**/*.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/LBM/bubble.0009.2.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/LBM/bubble.0064.115.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/LBM/bubble.0101.33.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/VOF/bubble.0218.6.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/VOF/bubble.0222.38.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/VOF/bubble.0225.71.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/VOF/bubble.0244.12.png
!/dataset/bubble_gym/bubble_mesh_thumbnails_400x400/VOF/bubble.0278.20.png

# Per-frame scene thumbnails are a local inspection aid, not a release artifact:
# the two scenes hold 172k meshes (~14 GB at 400x400), and only the 10k
# benchmark's thumbnails ship. Ignore every resolution.
/dataset/fruit_splash/bubble_mesh_thumbnails_*/
/dataset/exhalation/bubble_mesh_thumbnails_*/

# Trained artifacts are ignored in general, but the shipped production
# checkpoint + its scalers, and the exported baseline regressors, are versioned
# (they are what reproduces the paper's numbers without retraining).
**/*.joblib
**/*.pt
!python/freq_model/output/output_8feature_direct_bubblegym_10k/**
!python/freq_model/output/output_baseline_regressors_8feature/**
# Every ablation variant ships too. exp2_arch's weights are what the
# inference-timing benchmark loads (ablation_study/README_timing.md), and
# exp1_features' back the feature ablation in supplement Table 1 and Figs. 1-2;
# neither should need a retrain to reproduce.
!results/experiments/supp_table02_width_ablation/**
!results/experiments/supp_table01_feature_ablation/**
# Fig. 4's retrained surrogates ship as well: they are what its new panels are
# drawn from, and rerunning the production trainer will not reproduce them --
# their split pins the figure's own 100 bubbles out of train and val, so the
# weights are not recoverable from anything else in the repository.
!python/freq_model/output/fig04_retrain/**
# Deliberately still ignored: output_8feat_direct_bubblegym_10k_retrain/, a
# reproduction check rather than a shipped model. Its MLP scored 0.0894% against
# the shipped 0.0886%, and the canonical checkpoint was kept because swapping it
# would desync the rendered audio in dataset/*/trackedBubInfo_NN.txt. Committing
# it would put a second, non-canonical checkpoint beside the real one.
# ...but not the TensorBoard event files those negations would drag back in:
# they are per-run, host-named, and regenerated by any retrain.
python/freq_model/**/tensorboard/
results/**/tensorboard/
